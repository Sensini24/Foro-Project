<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hermes Messenger</title>
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="../css/chatstyles.css">
