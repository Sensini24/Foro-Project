<div class="comments-section">
    
    <div id="comment-container">
        <% commentsAll.forEach(comm =>{%>
            <div class="comment" id="commentsTotales">
                <%if(author == comm.user_name){%>
                    <div class="comment-author" id="comment-user-name">
                        <%= comm.user_name%>
                    </div>
                <%}else{%>
                    <div class="comment-author" ><%= comm.user_name %></div>
                <%}%>
                
                <div class="comment-date"><%= comm.date %></div>
                <div class="comment-text">
                        <%= comm.comment  %>
                </div>
                <div class="comment-id sr-only" id="id-comment">
                        <%= comm._id %>
                </div>
                <div class="postid-id sr-only" id="id-postid">
                        <%= comm.post_id %>
                </div>
                <div class="comment-status sr-only" id="id-status">
                    <%= comm.visible %>
                </div>
                <div class="comment-ocultar-delete">
                    <div class="btn-container" id="btn-container-request">
                        <button id="button-request" class="btn-comments">
                            Comentar
                        </button>
                    </div>
                    <div class="btn-container" id="btn-container-hide">
                        <% if(propietario){ %>
                            <button id="button-hide" class="btn-comments">
                                <%= comm.visible ? "Ocultar" : "Mostrar" %>
                            </button>
                            <span id="status-comment-user">
                                <%= comm.visible ? "" : "Este comentario solo es visible para tí" %>
                            </span>
                        
                        <% }else{%>
                            <%= console.log("Sin boton de ocultar")%>
                        <%} %>
                    </div>
                    <div class="btn-container" id="btn-container-delete">
                        
                        <!--Si el usuario actual es el propietario del post o si es author del comentario-->
                        <% if(username == comm.user_name || propietario){ %>
                            <%= console.log("Hay boton")%>
                                <button id="button-delete" class="btn-comments">
                                    Eliminar
                                </button>
                        <% }else{%>
                            <%= console.log("No eres")%>
                        <%} %>
                    </div>
                    
                </div>
                <!--LA PARTE DE CARGA DEL FORM DE LAS RESPUESTAS A COMENTARIOS.-->
                <div class="container-form-commentrequest">
                    <div id="request-name-header">
                        <p>Respuesta para: <span id="request-name"></span> </p>
                    </div>
                    <form id="formCommentRequest" style="display: flex; align-items: center; margin-top: 5px;">
                        <textarea type="text" name="comment" id="comment-content-request"></textarea>
                        <!-- <input type="hidden" name="post_id" value=""> -->
                            <button id="btn-comment-request" style="margin-left: 5px;">
                                <i class="material-icons add-comment">add_comment</i>
                            </button>
                    </form>
                    <button id="button-cancel" class="btn-comments" style="margin-top: 3px;">
                        Cancelar
                    </button>
                    <span id="aviso-comment"></span>
                </div>
            </div>
        <%}) %>
    </div>
</div>