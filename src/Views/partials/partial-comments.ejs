<div class="comments-section">
    
    <div id="comment-container">
        <% commentariosPrincipales.forEach(comm =>{%>
            <div class="comment" id="commentsTotales">
                <%if(author == comm.user_name){%>
                    <%if(comm.requestname == ""){%>
                        <!--Si el que comenta es dueño del post pero esta haciendo un comentario principal sin dirigirse a nadie entonces no se le agrea el requestname-->
                        <div class="container-headers">
                            <div class="comment-author" id="comment-user-name">
                                <%=  comm.user_name%>
                            </div>
                            <div class="comment-author-tag" id="comment-user-name">
                                <%= "(author)"%>
                            </div>
                        </div>
                    <%}else{%>
                        <!--Si el que comenta es dueño del post pero esta respondiendo otro comentario entonces se agrega el requestname-->
                        <div class="container-headers">
                            <div class="container-headers-comment-tag">
                                <div class="comment-author" id="comment-user-name">
                                    <%=  comm.user_name%>
                                    
                                </div>
                                <div class="comment-author-tag" id="comment-user-name">
                                    <%= "(author)"%>
                                </div>
                            </div>
                            <!--Si el nombre a quien se responde es el autor actual de post entonces se le agrega un (author)-->
                            <%if(comm.requestname == author){%>
                                <div id="receptor-message"> 
                                    <%= ">>" +  comm.requestname + "(author)"%> 
                                </div>
                            <%}%>
                        </div>
                    <%}%>
                <%}else{%>
                    <!--Cuando no es author del post-->
                    <%if(comm.requestname == ""){%>
                        <!--Si no es author del post y encima esta haciendo un comentario principal no se agrega el requestname-->
                        <div class="comment-author" id="comment-user-name">
                            <%=  comm.user_name%>
                            
                        </div>
                    <%}else{%>
                        <!--Si no es author del post y esta respondiendo otro comentario se agrega el requestname-->
                        <div class="container-headers">
                            <div class="comment-author" id="comment-user-name">
                                <%=  comm.user_name%>
                                
                            </div>
                            <!--Si el nombre a quien se responde es el autor actual de post entonces se le agrega un (author)-->
                            <%if(author === comm.requestname ){%>
                                <div id="receptor-message"> 
                                    <%= ">>" +  comm.requestname + "(author)"%> 
                                </div>
                            <%}else{%>
                                <div id="receptor-message"> 
                                    <%= ">>" +  comm.requestname%> 
                                </div>
                            <%}%>
                        </div>
                    <%}%>
                <%}%>
                
                <div class="comment-date"><%= comm.date %></div>
                <div class="comment-text">
                        <%= comm.comment  %>
                </div>
                <div class="comment-id sr-only" id="id-comment">
                        <%= comm._id %>
                </div>
                <div class="messageparent-id sr-only" id="id-messageparent">
                    <%= comm.idmessageparent%>
                </div>
                <div class="postid-id sr-only" id="id-postid">
                        <%= comm.post_id %>
                </div>
                <div class="comment-status sr-only" id="id-status">
                    <%= comm.visible %>
                </div>
                <div class="comment-ocultar-delete">
                    <!--Button de Muestra de comentarios-->
                    <%if(comm.idmessageparent == ""){%>
                    <div class="btn-container" id="btn-morecomments">
                        <span style="font-size: 15px;" id="Cargar">Cargar Comentarios</span>
                        <i class="material-icons add-comment" id="arrow-requests"> arrow_drop_down</i>
                    </div>
                    <%}%>
                    <!--Button de comentario-->
                    <div class="btn-container" id="btn-container-request">
                        <button id="button-request" class="btn-comments">
                            Comentar
                        </button>
                    </div>
                    <!--Button de Ocultamiento-->
                    <div class="btn-container" id="btn-container-hide">
                        <% if(propietario){ %>
                            <button id="button-hide" class="btn-comments">
                                <%= comm.visible ? "Ocultar" : "Mostrar" %>
                            </button>
                            <span id="status-comment-user">
                                <%= comm.visible ? "" : "Este comentario solo es visible para tí" %>
                            </span>
                        
                        <% }else{%>
                            <%= console.log("Sin boton de ocultar")%>
                        <%} %>
                    </div>
                    <!--Button de Eliminacion-->
                    <div class="btn-container" id="btn-container-delete">
                        
                        <!--Si el usuario actual es el propietario del post o si es author del comentario-->
                        <% if(username == comm.user_name || propietario){ %>
                            <%= console.log("Hay boton")%>
                                <button id="button-delete" class="btn-comments">
                                    Eliminar
                                </button>
                        <% }else{%>
                            <%= console.log("No eres")%>
                        <%} %>
                    </div>
                    
                    
                </div>
                <!--LA PARTE DE CARGA DEL FORM DE LAS RESPUESTAS A COMENTARIOS.-->
                <div class="container-form-commentrequest">
                    <div id="request-name-header">
                        <p>Respuesta para: <span id="request-name"></span> </p>
                    </div>
                    <form id="formCommentRequest" style="display: flex; align-items: center; margin-top: 5px;">
                        <textarea type="text" name="comment" id="comment-content-request"></textarea>
                        <!-- <input type="hidden" name="post_id" value=""> -->
                        <button id="btn-comment-request" style="margin-left: 5px;">
                            <i class="material-icons add-comment" id="icon-addcomment">add_comment</i>
                        </button> 
                    </form>
                    <button id="button-cancel" class="btn-comments" style="margin-top: 3px;">
                        Cancelar
                    </button>
                    <span id="aviso-comment"></span>
                </div>
                <div id="partial-request-cont">

                </div>
            </div>
        <%}) %>
    </div>
</div>