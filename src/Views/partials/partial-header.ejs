<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Header con Estilo</title>

    <!-- <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"> -->
    <!-- <link rel="stylesheet" href="header.css"> -->
</head>
<body>
    <header class="navbar">
        <!-- Logo y nombre -->
        <div class="navbar-logo">
            <img src="https://via.placeholder.com/50" alt="Olympus Tech Logo" class="logo-image">
            <span class="logo-text">Olympus Tech</span>
        </div>
        
        <!-- Formulario de búsqueda -->
        <form class="search-form">
            <input type="search" placeholder="Search the realm of knowledge..." class="search-input">
            <button type="submit" class="search-button">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>
        </form>
        
        <!-- Opciones de usuario -->
        <div class="navbar-profile">
            <% if (usuario) { %>
                <!-- Mostrar nombre del usuario -->
                <h3>Hola <%= usuario.user_name %></h3>
                
                <!-- Foto de perfil y opciones -->
                <div class="user-photo">
                    <img id="img-user" src="https://via.placeholder.com/40" alt="Foto de usuario" class="profile-image" />
                </div>
                
                <!-- Subir foto -->
                <form enctype="multipart/form-data" id="formImage">
                    <input type="file" name="profilePic" id="id-foto" />
                    <button type="submit" class="upload-button">Subir Foto</button>
                </form>
                
                <!-- Botón de ajustes -->
                <a href="#" class="settings-button"><i class="fas fa-cog"></i></a>
                
                <!-- Botón de logout -->
                <form action="/auth/logout" method="get" style="display: inline;">
                    <button type="submit" class="logout-button">
                        <i class="material-icons">logout</i> Logout
                    </button>
                </form>
            <% } else { %>
                <!-- Botón de login si no hay usuario -->
                <div class="login-container">
                    <a href="/auth/login" class="login-link">
                        <span class="material-icons">login</span> Ingresar
                    </a>
                </div>
            <% } %>
        </div>
    </header>
</body>

</html>
<script>
    // const inputFile = document.getElementById("id-foto")
    // inputFile.addEventListener("change", ()=>{
    //     console.log("Archivo: ", inputFile.value)
    // })

    const formImage = document.getElementById("formImage")
    const fileImage = document.getElementById("id-foto")
    formImage.addEventListener("submit", (event)=>{
        event.preventDefault()

        
        const files = fileImage.files[0];
        const formData = new FormData();
        formData.append("profilePic", files);

        fetch("/user/uploadImage",{
        method:"POST",
        body: formData
    }).then(response => response.json()) // Procesa la respuesta del servidor
    .then(data => {
      console.log("Imagen subida con éxito:", data.file);
      console.log(data.message)
    })
    .catch(error => {
      console.error("Error al subir la imagen:", error);
    });
    })

    const img_user = document.getElementById("img-user")
    fetch("/user/getUser")
    .then(response => response.json())
    .then(data => {
        if(data.usuario == null){
            console.log("NO hay usuario")
            img_user.src = "/Images/avatar/user.png"
            console.log(data.message)
            console.log(data.usuario)
            console.log("No tiene una imagen prevista: ", img_user.src)
        }else{
            console.log("usuario obtenido")
            console.log(data.message)
            console.log(data.usuario)
            // const pathAdecuado = data.usuario.substring(6,data.usuario.lenght)
            // console.log("Path adecuado: ", ".." + pathAdecuado)
            img_user.src = data.usuario
            console.log("")
            console.log("Imagen cargada: ", img_user.src)
        }

    })
    
    .catch(error => {
        console.error('Error:', error);
    });
    
    const postsidheader = document.getElementById("post-id-header")

    postsidheader.addEventListener("click", ()=>{
        console.log("BOTON DE POST EN HEADER CLICKADO")
    })
</script>