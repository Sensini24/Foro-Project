<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bienvenido al Chat</title>
</head>
<body>
    <div class="welcome-container">
        <div class="welcome-circle">
            <div class="floating-icons">
                <span class="floating-icon">✨</span>
                <span class="floating-icon">💭</span>
                <span class="floating-icon">💫</span>
                <span class="floating-icon">⭐</span>
            </div>
        </div>
        <h1 class="welcome-title">¡Bienvenido al chat!</h1>
        <p class="welcome-subtitle">Inicia una conversación directa o grupal con otros usuarios.</p>
        <button class="start-chat-btn">Iniciar nuevo chat</button>
    </div>
</body>
</html>