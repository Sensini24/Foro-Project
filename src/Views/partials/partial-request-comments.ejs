<div class="comments-section">
    
    <div id="comment-container">
        <% commentariosPrincipales.forEach(comm =>{%>
            <div class="comment" id="commentsTotales">
                <%if(author == comm.user_name){%>
                    <div class="comment-author" id="comment-user-name">
                        <% const usernameauthor = comm.user_name == comm.requestname ? comm.user_name + "(author)" : comm.user_name%>
                        <% const userrequestname = comm.user_name == comm.requestname ? comm.requestname+ "(author)" : comm.requestname%>
                        <%= usernameauthor%>
                    </div>
                    <div>
                        <%= " >> " + userrequestname%>
                    </div>
                <%}else{%>
                    <div class="comment-author" ><%= comm.user_name " >> " +  comm.requestname%></div>
                    <div> <%= " >> " +  comm.requestname%> </div>
                <%}%>
                

                <div class="comment-date"><%= comm.date %></div>
                <div class="comment-text">
                        <%= comm.comment  %>
                </div>
                <div class="comment-id sr-only" id="id-comment">
                        <%= comm._id %>
                </div>
                <div class="messageparent-id" id="id-messageparent">
                    <%= comm.idmessageparent  + "HOLA"%>
                </div>
                <div class="postid-id sr-only" id="id-postid">
                        <%= comm.post_id %>
                </div>
                <div class="comment-status sr-only" id="id-status">
                    <%= comm.visible %>
                </div>
                <div class="comment-ocultar-delete">
                    <%if(comm.idmessageparent == null){%>
                    <div class="btn-container" id="btn-morecomments">
                        <span style="font-size: 15px;" id="Cargar">Cargar Comentarios</span>
                        <i class="material-icons add-comment" id="arrow-requests"> arrow_drop_down</i>
                    </div>
                    <%}%>

                    <div class="btn-container" id="btn-container-request">
                        <button id="button-request" class="btn-comments">
                            Comentar
                        </button>
                    </div>
                    <div class="btn-container" id="btn-container-hide">
                        <% if(propietario){ %>
                            <button id="button-hide" class="btn-comments">
                                <%= comm.visible ? "Ocultar" : "Mostrar" %>
                            </button>
                            <span id="status-comment-user">
                                <%= comm.visible ? "" : "Este comentario solo es visible para tí" %>
                            </span>
                        
                        <% }else{%>
                            <%= console.log("Sin boton de ocultar")%>
                        <%} %>
                    </div>
                    <div class="btn-container" id="btn-container-delete">
                        
                        <!--Si el usuario actual es el propietario del post o si es author del comentario-->
                        <% if(username == comm.user_name || propietario){ %>
                            <%= console.log("Hay boton")%>
                                <button id="button-delete" class="btn-comments">
                                    Eliminar
                                </button>
                        <% }else{%>
                            <%= console.log("No eres")%>
                        <%} %>
                    </div>
                    
                    
                </div>
                <!--LA PARTE DE CARGA DEL FORM DE LAS RESPUESTAS A COMENTARIOS.-->
                <div class="container-form-commentrequest">
                    <!-- Header con nombre al que se responde -->
                    <div id="request-name-header">
                        <p class="reply-to">@<span id="request-name"></span></p>
                    </div>
                
                    <!-- Formulario para agregar comentarios -->
                    <form id="formCommentRequest" style="display: flex; flex-direction: column; margin-top: 5px;" class="comment-field v3">
                        <!-- Campo de texto para la respuesta -->
                        <textarea 
                            placeholder="Escribe tu respuesta aquí..." 
                            id="comment-content-request" 
                            name="comment"
                            style="resize: none;">
                        </textarea>
                        
                        <!-- Acciones de enviar y cancelar -->
                        <div class="actions" style="display: flex; gap: 10px; justify-content: flex-end;">
                            <!-- Botón de cancelar -->
                            <button id="button-cancel" class="btn-comments btn-cancel" title="Cancelar">
                                ×
                            </button>
                
                            <!-- Botón de enviar -->
                            <button id="btn-comment-request-child" class="btn-submit" title="Enviar">
                                ↵
                            </button>
                        </div>
                    </form>
                
                    <!-- Aviso para el estado del comentario -->
                    <span id="aviso-comment" style="color: red; margin-top: 5px;"></span>
                </div>
                
            </div>
        <%}) %>
    </div>
</div>
