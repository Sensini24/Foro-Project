<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="../css/notifications.css">
    <title>Notificaciones</title>
</head>
<body>
    <div class="notifications-container">
        <div class="notifications-header">
            <div class="header-title">
                <h1>Notificaciones</h1>
                <span class="notification-count">
                    <%=notifications.length%>
                </span>
            </div>
            <div class="header-actions">
                <button class="btn">
                    <span>Filtrar</span>
                </button>


                <button class="btn btn-primary" id="btn-allread">
                    <span>Marcar todo como leído</span>
                </button>
            </div>
        </div>

        <div class="filters">
            <button class="filter-btn">Todas</button>
            <button class="filter-btn">Sin leer</button>
            <button class="filter-btn">Leídas</button>
            <button class="filter-btn">Menciones</button>
            <button class="filter-btn">Comentarios</button>
            <button class="filter-btn">Likes</button>
            <button class="filter-btn">Contactos</button>
            <!-- <button class="filter-btn">Actualizaciones</button>
            <button class="filter-btn">Sistema</button> -->
        </div>

        <div class="notification-list">
            <!-- Notificación con acciones -->
            <% if(notifications.length <1){ %>
                <h3 style="display: flex; align-items: center; justify-content: center;">No tiene notificaciones</h3>
            <%}else{%>
                <% notifications.forEach(notif => { %>
                    <div class="notification-item unread" data-sender-id="<%= notif.senderId %>" data-recipient-id="<%= notif.recipientId%>" data-post-id="<%= notif.pathsIds.id_post%>" data-comment-id="<%= notif.pathsIds.id_comment%>" data-notif-id="<%= notif._id%>">
                        <div class="avatar">JD</div>
                        <div class="notification-content">
                            <div class="notification-header">
                                <!-- <%if(notif.type == "firstmessage"){%>
                                    <span class="notification-title">Nuevo Contacto</span>
                                <%}%> -->
                                <span class="notification-title"><%= notif.type %></span>
                                <span class="notificationInterfaz-time"><%= notif.createdAt %></span>
                            </div>
                            <p class="notification-message">
                                <%= notif.message %>
                            </p>
                            <!-- <%if(notif.type == "firstmessage"){%>
                                <div class="notification-actions" >
                                    <button class="action-btn accept">Aceptar</button>
                                    <button class="action-btn reject">Rechazar</button>
                                </div>
                            <%}else if(notif.type == "youlike"){%>
                                <div class="notification-actions">
                                    <button class="action-btn">Responder</button>
                                    <button class="action-btn">Ver comentario</button>
                                </div>
                            <%}%> -->
                        </div>
                    </div>
                    <%})%>
                
            <%}%>
            
        </div>
    </div>
</body>
</html>