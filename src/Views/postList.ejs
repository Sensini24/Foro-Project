<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Blogs</title>
    <link rel="stylesheet" href="../css/postList.css">
</head>
<body>
    <div class="contenido-total">
        <div class="header-contain">
            <h1 id="titulo">Entradas de blogs</h1>
            <% if(usuario){ %>
                <h1>Hola <%= usuario.user_name %></h1>
            <% }else{ %>
            <% } %>
        </div>
    
        <div class="partial-containers">
        
            <div id="partial-posts">
        
            </div>
        </div>
    </div>
</body>
</html>
<script>
    document.addEventListener('DOMContentLoaded',()=>{
        const partialPosts = document.getElementById("partial-posts")
        fetch("/post/partialAllPost")
        .then(response => response.text())
        .then(data=>{
            console.log("Posts totales cargados")
            partialPosts.innerHTML = data
        })
        
    })
   
    
</script>