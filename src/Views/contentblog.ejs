<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detalle del Blog</title>
    <script src="/socket.io/socket.io.js"></script>
    <link rel="stylesheet" href="../css/contentblog.css">
    <link rel="stylesheet" href="../css/comments.css">
    <!-- Uso de google fonts -->
</head>
<body>
    <div class="container" id="cuerpo-post-blog">
        <!-- Título del post -->
        <div class="blog-title sr-only" aria-hidden="true" id="id-post"><%= post.id %></div>
        <h1 class="blog-title" id="title-post"><%= post.title %></h1>
    
        <!-- Metadatos -->
        <div class="post-meta">
            <div class="blog-author"><%= post.author_id.user_name %></div>
            <div class="blog-date">Published on <%= post.date %></div>
        </div>
    
        <!-- Tags -->
        <div class="blog-tags">
            <strong>Tags:</strong>
            <% if (post.tags.length > 0) { %>
                <% post.tags.forEach(tag => { %>
                    <span id="tags-elements" class="tag-item"><%= tag %></span>
                <% }); %>
            <% } else { %>
                <h3>No existen tags</h3>
            <% } %>
        </div>
    
        <!-- Contenido del post -->
        <div class="blog-content">
            <p><%= post.content %></p>
        </div>
    
        <!-- Interacciones -->
        <div class="post-actions">
            <h3 style="margin-bottom: 10px;">¿Qué opinas de este post?</h3>
            <div class="interactions-row likes-dislikes">
                <div id="add-like" class="individual-interactions">
                    <i class="material-icons add-like">thumb_up</i>
                    <span id="like-count" class="span-number like-count">0</span>
                </div>
                <div id="add-dislike" class="individual-interactions">
                    <i class="material-icons add-dislike">thumb_down</i>
                    <span id="dislike-count" class="span-number dislike-count">0</span>
                </div>
                <div id="add-share" class="individual-interactions">
                    <i class="material-icons add-share">share</i>
                    <span id="share-count" class="span-number">0</span>
                </div>
            </div>
        </div>
    
        <!-- Comentarios -->
        <div class="comments">
            <h3 style="margin-top: 30px;">Comentarios</h3>
            <form id="formComment" class="comment-form" style="display: flex; align-items: center;">
                <textarea type="text" name="comment" id="comment-id" placeholder="Comenta algo..."></textarea>
                <button id="btn-comment">
                    <i class="material-icons add-comment">add_comment</i>
                </button>
            </form>
            <span id="aviso-comment"></span>
            <div id="partial-container"></div>
        </div>
    
        <!-- Modal de registro -->
        <div id="modal-register" class="modal" style="display:none;">
            <div class="modal-content">
                <span id="close-modal" class="close">&times;</span>
                <h2>Regístrate para comentar</h2>
                <p>Debes iniciar sesión o registrarte para poder dejar un comentario.</p>
                <a href="/auth/sign-up">Regístrate aquí</a>
                <a href="/auth/login">Iniciar sesión</a>
            </div>
        </div>

        <div id="modal-success"></div>
    </div>
    
        <!-- <script src="../client/getComments"></script> -->
</body>
</html>
