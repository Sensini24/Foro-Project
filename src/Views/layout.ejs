<!DOCTYPE html>
<html>
    <head>
        <title>Foro blog de Brandon</title>
        
        <!-- Estilos CSS y Fuentes -->
        
        <link rel="stylesheet" href="../css/header.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.cdnfonts.com/css/cascadia-code" rel="stylesheet">
        <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
        
        <!-- Scripts de librerías -->
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    </head>
    
<body>
    <%- include('partials/partial-header') %>
    
    <main class="main-layout">
        <!--ATAJOS-->
        <div class="sidebar">
            <h3>Posts</h3>
            <div class="group-item" id="allposts-atajos-posts">
                <a href="/post/partialAllPost" style="text-decoration: none; color: #6984A8;" ><span>📑 Todos los posts</span></a> 
            </div>
            <div class="group-item" id="user-atajos-posts">
                <a href="/user/posts"><span>📑 Mis Posts</span> </a>
            </div>
            <div class="group-item" id="nuevopost-atajos-posts">
                <a href="/post/addpostget"><span>📑 Nuevo Post</span></a>
            </div>

            <div class="decorative-line"></div>

            <h3>Atajos de usuario</h3>
            <div class="group-item">
                <span>📑 Guardados</span>
            </div>
            
            <div class="decorative-line"></div>
            
            <h3>Grupos literarios</h3>
            <div class="group-item">
                <span>🔒 Vida de Dostoiewski</span>
            </div>
        </div>

        <!--BODY-->
        <div class="contenido">
            <%- body %>
        </div>
        
        <!--TAGS-->
        <div class="tags-container">
            <h3>Tags más buscados</h3>
            <div class="tag">1. Literatura</div>
            <div class="tag">2. Mitología</div>
            <div class="tag">3. Edgar Allan Poe</div>
        </div>
    </main>
    <script src="../client/app.js" type="module"></script>
    
</body>
</html>