<!DOCTYPE html>
<html>
    <head>
        <title>Foro blog de Brandon</title>
        
        <!-- Estilos CSS y Fuentes -->
        
        <link rel="stylesheet" href="../css/header.css">
        <link rel="stylesheet" href="../css/header-elements.css">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.cdnfonts.com/css/cascadia-code" rel="stylesheet">
        <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
        
        <!-- Scripts de librerías -->
        <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
        <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    </head>
    
<body>
    <header class="header-selector">
        <%- include('partials/partial-header') %>
    </header>
    
    
    <main class="main-layout">
        <!--ATAJOS-->
        <aside class="sidebar left-sidebar">
                <%- include('partials/partial-sidebar') %>
            
            
        </aside>

        <!--BODY-->
        <div class="contenido">
            <%- body %>
        </div>
        
        <!--TAGS-->
        <aside class="tags-container sidebar right-sidebar">
            <%- include('partials/partial-tags') %>
        </aside>
    </main>

    <% if (usuario) { %>
        <div id="chat-icon" class="chat-icon">
            <span class="material-icons">chat</span>
        </div>
        <div id="chat-container" class="chat-overlay">
            <%- include('partials/chats') %>
        </div>
    <% }%>
    
    <script src="../client/app.js" type="module"></script>
    
</body>
</html>